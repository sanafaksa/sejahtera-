generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("admin") @db.VarChar(20) // "admin" | "superadmin"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// Submissions from the public contact form, shown in the admin dashboard.
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(160)
  phone     String?  @db.VarChar(40)
  subject   String   @db.VarChar(120)
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}

model Product {
  id             Int                   @id @default(autoincrement())
  name           String                @db.VarChar(255)
  slug           String                @unique @db.VarChar(255)
  description    String?
  details        String?
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  highlights     ProductHighlight[]
  images         ProductImage[]
  specifications ProductSpecification?

  @@map("products")
}

model ProductHighlight {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  icon      String? @db.VarChar(100)
  text      String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_highlights")
}

model ProductSpecification {
  id        Int     @id @default(autoincrement())
  productId Int     @unique @map("product_id")
  size      String? @db.VarChar(100)
  finishing String? @db.VarChar(100)
  material  String? @db.VarChar(150)
  price     String? @db.VarChar(100)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specifications")
}

model ProductImage {
  id         Int     @id @default(autoincrement())
  productId  Int     @map("product_id")
  imageUrl   String  @map("image_url")
  isFeatured Boolean @default(false) @map("is_featured")
  isCatalog  Boolean @default(false) @map("is_catalog")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model GalleryAsset {
  id          Int       @id @default(autoincrement())
  title       String?
  description String?
  url         String
  type        String    // "image" | "video"
  category    String?
  tags        String[]  @default([])
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("gallery_assets")
}

// ---------------------------------------------------------------------------
// Analytics: one row per counted page view. No raw IP is ever stored; the
// visitor id is a random value kept in a first-party cookie.
// ---------------------------------------------------------------------------
model PageVisit {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now()) @map("created_at") // stored in UTC
  visitorId    String   @map("visitor_id") @db.VarChar(64)
  path         String   @db.VarChar(512)
  productSlug  String?  @map("product_slug") @db.VarChar(255)
  country      String?  @db.VarChar(2) // ISO 3166-1 alpha-2
  region       String?  @db.VarChar(16) // ISO 3166-2 subdivision code (without country)
  city         String?  @db.VarChar(120)
  latitude     Float?   // approximate (IP) or precise (GPS) — see geoPrecise
  longitude    Float?
  geoPrecise   Boolean  @default(false) @map("geo_precise") // true = from the visitor's GPS (consented)
  accuracyM    Int?     @map("accuracy_m") // GPS accuracy in metres, when precise
  timezone     String?  @db.VarChar(64) // IANA name, e.g. "Europe/Berlin"
  device       String   @db.VarChar(16) // "mobile" | "tablet" | "desktop"
  os           String?  @db.VarChar(40)
  browser      String?  @db.VarChar(40)
  inApp        String?  @map("in_app") @db.VarChar(20) // "Instagram" | "Facebook" | "TikTok" | ...
  source       String   @db.VarChar(80) // "Langsung", "Google", "Instagram", utm_source, ...
  referrerHost String?  @map("referrer_host") @db.VarChar(255)
  utmSource    String?  @map("utm_source") @db.VarChar(100)
  utmMedium    String?  @map("utm_medium") @db.VarChar(100)
  utmCampaign  String?  @map("utm_campaign") @db.VarChar(100)

  @@index([createdAt])
  @@index([visitorId, path, createdAt])
  @@index([country, createdAt])
  @@map("page_visits")
}

// Admin settings stored as JSON per feature ("clock", "invoice", ...).
model AppSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Invoices. Money is stored as Decimal; totals are recomputed on the server.
// ---------------------------------------------------------------------------
model Invoice {
  id               Int           @id @default(autoincrement())
  number           String        @unique @db.VarChar(40)
  publicToken      String        @unique @map("public_token") @db.VarChar(64)
  status           String        @default("draft") @db.VarChar(16) // draft | sent | paid | overdue | cancelled
  language         String        @default("en") @db.VarChar(2) // en | id
  currency         String        @default("USD") @db.VarChar(3)
  customerName     String        @map("customer_name") @db.VarChar(160)
  customerCompany  String?       @map("customer_company") @db.VarChar(160)
  customerEmail    String?       @map("customer_email") @db.VarChar(200)
  customerPhone    String?       @map("customer_phone") @db.VarChar(60)
  customerAddress  String?       @map("customer_address")
  customerCountry  String?       @map("customer_country") @db.VarChar(2)
  customerTimezone String?       @map("customer_timezone") @db.VarChar(64)
  issueDate        DateTime      @map("issue_date") @db.Date
  dueDate          DateTime?     @map("due_date") @db.Date
  discountType     String        @default("percent") @map("discount_type") @db.VarChar(8) // percent | amount
  discountValue    Decimal       @default(0) @map("discount_value") @db.Decimal(16, 2)
  taxEnabled       Boolean       @default(false) @map("tax_enabled")
  taxLabel         String        @default("PPN") @map("tax_label") @db.VarChar(40)
  taxRate          Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  shipping         Decimal       @default(0) @db.Decimal(16, 2)
  subtotal         Decimal       @default(0) @db.Decimal(16, 2)
  discountTotal    Decimal       @default(0) @map("discount_total") @db.Decimal(16, 2)
  taxTotal         Decimal       @default(0) @map("tax_total") @db.Decimal(16, 2)
  total            Decimal       @default(0) @db.Decimal(16, 2)
  notes            String?
  terms            String?
  paymentMethodIds String[]      @default([]) @map("payment_method_ids")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  items            InvoiceItem[]

  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  position    Int
  productId   Int?     @map("product_id")
  sku         String?  @db.VarChar(64)
  name        String   @db.VarChar(255)
  description String?
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(16, 2)
  amount      Decimal  @db.Decimal(16, 2)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

// Sequence per numbering scope ("INV:2026" when numbers reset yearly).
model InvoiceCounter {
  scope String @id @db.VarChar(64)
  last  Int    @default(0)

  @@map("invoice_counters")
}
